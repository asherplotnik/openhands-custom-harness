# Choose exactly one provider: gemini or groq.
BANK_AGENT_PROVIDER=gemini

# Stop an unresponsive model request after two minutes and retry it once.
BANK_AGENT_LLM_TIMEOUT_SECONDS=120
BANK_AGENT_LLM_NUM_RETRIES=1

# Native Gemini connector (no Node.js, local HTTP bridge, or OpenCode harness).
BANK_AGENT_GEMINI_MODEL=gemini-3.8-flash
BANK_AGENT_GEMINI_BASE_URL=https://connector-host/api/connectors/connector-id
BANK_AGENT_GEMINI_VERTEX_PROJECT=your-project
BANK_AGENT_GEMINI_VERTEX_LOCATION=your-location
BANK_AGENT_GEMINI_API_KEY=replace-with-bank-managed-secret

# Groq alternative.
# BANK_AGENT_GROQ_MODEL=openai/gpt-oss-120b
# BANK_AGENT_GROQ_BASE_URL=https://api.groq.com/openai/v1
# BANK_AGENT_GROQ_API_KEY=replace-with-bank-managed-secret
